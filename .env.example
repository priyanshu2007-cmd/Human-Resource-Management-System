# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, never NEXT_PUBLIC_. Used for admin
# operations (e.g. creating an employee's auth user). Never import
# lib/supabase/admin.ts from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
